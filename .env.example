# ============================================================
# CloudDrive R2 - 環境変数サンプル
# コピーして .env を作成し、実際の値を入力してください（.env は gitignore 対象）
#   cp .env.example .env
# ============================================================

# Better Auth
# BETTER_AUTH_URL: アプリの完全な URL（本番は実際のドメインに変更、例: https://clouddrive.example.com）
BETTER_AUTH_URL=https://clouddrive.example.com
# BETTER_AUTH_SECRET: Better Auth の署名用ランダム文字列（32 文字以上）
# 生成: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Cloudflare Email Service — ローカル開発での実送信
# Token 作成: https://dash.cloudflare.com/profile/api-tokens 権限 Email Sending:Edit
# 送信元ドメインは Cloudflare Email Service で検証する必要があります
# CLOUDFLARE_ACCOUNT_ID: Cloudflare アカウント ID（ダッシュボード右下に表示）
CLOUDFLARE_ACCOUNT_ID=
# CF_API_TOKEN_SEND_EMAIL: Email Sending 権限の API Token
CF_API_TOKEN_SEND_EMAIL=
# EMAIL_FROM: 送信元アドレス（Cloudflare Email Service で設定したドメインを使用）
EMAIL_FROM=no-reply@clouddrive.example.com

# DEV_CONSOLE_EMAIL=true の場合は実際には送信せず、確認コードをターミナルに表示します（ローカルデバッグ用）
DEV_CONSOLE_EMAIL=true
